# Kopiere diese Datei nach .env und trage deine Werte ein.

# Schlüssel für die Textvorschläge (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: anderes Modell verwenden
# ANTHROPIC_MODEL=claude-opus-5

# Port des Cockpits
PORT=4000

# Optional: Ablageort für Datenbank und Bilder (Standard: ./data)
# DATA_DIR=./data

# Optional: Version der Instagram Graph API
# IG_API_VERSION=v21.0

# Optional: Taktung des Auto-Posting-Dienstes in Millisekunden (Standard: 60000)
# SCHEDULER_TICK_MS=60000
